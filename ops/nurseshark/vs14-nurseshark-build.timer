[Unit]
Description=Vacation Station 14 — nurseshark daily rebuild timer
Documentation=file:///opt/vacation-station/docs/OPERATIONS.md

[Timer]
# 05:30 UTC daily — after ss14-backup (03:15 UTC), replay-rotate
# (04:30 UTC), cookbook (05:00 UTC) and guidebook (05:15 UTC) so the
# static-site rebuilds don't fight for disk + network. 15-min jitter
# keeps reboot catch-up from piling timers onto the same minute.
OnCalendar=*-*-* 05:30:00 UTC
RandomizedDelaySec=15min
Persistent=true
Unit=vs14-nurseshark-build.service

[Install]
WantedBy=timers.target
