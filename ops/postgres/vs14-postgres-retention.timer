[Unit]
Description=Vacation Station 14 — nightly PostgreSQL retention prune timer
Documentation=file:///opt/vacation-station/docs/OPERATIONS.md

[Timer]
# 03:30 UTC every day — runs 15 minutes after ss14-backup.timer (03:15)
# so the prune happens on a freshly backed-up database.
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
Persistent=true
Unit=vs14-postgres-retention.service

[Install]
WantedBy=timers.target
